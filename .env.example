# Example environment file. Copy to .env and fill in real values.
# Names only — never commit real secrets here.

# Seed account passwords (server/seed.ts).
# If unset, the seed will SKIP creating that account rather than fall back to a
# hardcoded password. Required in any environment where these accounts must exist.
# Note: passwords are only applied at account CREATION; existing accounts are never reset.
SEED_SCHOOLADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
